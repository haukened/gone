# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov
lcov.info

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum
TODO.md

# env file
.env
.envrc

# Editor/IDE
# .idea/
# .vscode/


#Ignore vscode AI rules
.github/instructions/codacy.instructions.md

# the binary
/gone
/goned
/cmd/gone/gone
/cmd/goned/goned
/bin

# local tmp folder for development
/.tmp/

# web dist assets
/web/dist/

# nix stuff
.direnv/

# local MCP servers
.mcp.json

# Codacy local analysis artifacts
.codacy/.gitignore
.codacy/codacy.config*.json
.codacy/generated/

# Local JFrog CLI config
.jfrog/

# Playwright MCP scratch output
.playwright-mcp/

# Release archives (scripts/release.sh)
dist/
