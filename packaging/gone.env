# Settings for the Gone server (gone.service). After a change, run:
#   sudo systemctl restart gone
# Every setting is described in
# https://github.com/haukened/gone/blob/main/docs/configuration.md

# Gone listens on localhost only: browsers need HTTPS for Gone's encryption,
# so put a TLS proxy (Caddy, nginx, a Cloudflare Tunnel) in front of it.
GONE_ADDR=127.0.0.1:8080

# The proxy's address, so rate limits apply per visitor. 127.0.0.1 when it
# runs on this machine.
#GONE_TRUSTED_PROXIES=127.0.0.1

# Largest secret in bytes, and the expiry choices.
#GONE_MAX_BYTES=10485760
#GONE_TTL_OPTIONS=5m,30m,1h,2h,4h,8h,24h

# Require a passphrase on every secret; limit or turn off attachments.
#GONE_REQUIRE_PASSPHRASE=true
#GONE_MAX_FILES=0

# Metrics on a separate listener, behind a bearer token.
#GONE_METRICS_ADDR=127.0.0.1:9090
#GONE_METRICS_TOKEN=

# The data directory is set by the service (/var/lib/gone); don't set
# GONE_DATA_DIR here.
